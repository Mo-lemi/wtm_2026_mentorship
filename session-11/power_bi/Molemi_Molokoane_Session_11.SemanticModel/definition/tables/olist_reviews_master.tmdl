	column order_purchase_timestamp
		dataType: dateTime
		formatString: General Date
		lineageTag: 6fc43af7-f11f-4a79-8e47-9ae6f6b363f6
		summarizeBy: none
		sourceColumn: order_purchase_timestamp

		annotation SummarizationSetBy = User

	column order_approved_at
		dataType: dateTime
		formatString: General Date
		lineageTag: 3af81653-3097-4952-b2e0-e9748e720842
		summarizeBy: none
		sourceColumn: order_approved_at

		annotation SummarizationSetBy = User

	column order_delivered_carrier_date
		dataType: dateTime
		formatString: General Date
		lineageTag: b26413c5-5b66-4538-80bb-765eaf9d8727
		summarizeBy: none
		sourceColumn: order_delivered_carrier_date

		annotation SummarizationSetBy = User

	column order_delivered_customer_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 0cb5952b-6aad-4001-9402-451e627bbfdd
		summarizeBy: none
		sourceColumn: order_delivered_customer_date

		annotation SummarizationSetBy = User

	column order_estimated_delivery_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 73216a89-cc4c-46a0-877b-d79128b3f876
		summarizeBy: none
		sourceColumn: order_estimated_delivery_date

		annotation SummarizationSetBy = User

	column customer_unique_id
		dataType: string
		lineageTag: 8cbecf03-1925-4ecc-a79d-e9ae2383fc36
		summarizeBy: none
		sourceColumn: customer_unique_id

		annotation SummarizationSetBy = User

	column customer_zip_code_prefix
		dataType: string
		lineageTag: 9537eb61-0e8e-47f0-b72a-e827b4c83707
		summarizeBy: none
		sourceColumn: customer_zip_code_prefix

		annotation SummarizationSetBy = User

	column customer_city
		dataType: string
		lineageTag: b389b914-cdbf-4f00-a3cf-5f37a1df41e8
		summarizeBy: none
		sourceColumn: customer_city

		annotation SummarizationSetBy = User

	column customer_state
		dataType: string
		lineageTag: ee0d4eda-724f-4079-9c41-ee1396f735f3
		summarizeBy: none
		sourceColumn: customer_state

		annotation SummarizationSetBy = User

	column 'Delay Days' = IF(ISBLANK(olist_reviews_master[order_delivered_customer_date]), BLANK(), DATEDIFF(olist_reviews_master[order_estimated_delivery_date], olist_reviews_master[order_delivered_customer_date], DAY))
		dataType: int64
		formatString: 0
		lineageTag: 9886e2ab-a6c6-4c6d-a137-d33c66156c6c
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Delivery Status' = VAR d = olist_reviews_master[Delay Days] RETURN SWITCH(TRUE(), ISBLANK(d), "Not delivered", d <= -15, "15+ days early", d <= -8, "8-14 days early", d < 0, "1-7 days early", d = 0, "On time", d <= 7, "1-7 days late", d <= 14, "8-14 days late", "15+ days late")
		dataType: string
		lineageTag: eced2a0a-eced-453e-b3ae-8d0cb864ba54
		summarizeBy: none
		sortByColumn: 'Delivery Status Order'

		annotation SummarizationSetBy = User

	column 'Delivery Status Order' = VAR d = olist_reviews_master[Delay Days] RETURN SWITCH(TRUE(), ISBLANK(d), 8, d <= -15, 1, d <= -8, 2, d < 0, 3, d = 0, 4, d <= 7, 5, d <= 14, 6, 7)
		dataType: int64
		formatString: 0
		lineageTag: 5785bb93-4af4-4cca-861c-a464d409ba57
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition olist_reviews_master = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "olist_reviews_master.csv"), [Delimiter=",", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"review_id", type text}, {"order_id", type text}, {"review_score", Int64.Type}, {"review_comment_title", type text}, {"review_comment_message", type text}, {"review_creation_date", type datetime}, {"review_answer_timestamp", type datetime}, {"customer_id", type text}, {"order_status", type text}, {"order_purchase_timestamp", type datetime}, {"order_approved_at", type datetime}, {"order_delivered_carrier_date", type datetime}, {"order_delivered_customer_date", type datetime}, {"order_estimated_delivery_date", type datetime}, {"customer_unique_id", type text}, {"customer_zip_code_prefix", type text}, {"customer_city", type text}, {"customer_state", type text}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
