		lineageTag: 0762e03e-ee12-458a-9972-a77ae72800c7
		summarizeBy: none
		sourceColumn: review_comment_title

		annotation SummarizationSetBy = User

	column review_comment_message
		dataType: string
		lineageTag: a3ecbf39-c3f6-4d5e-94c7-70ad952fdf2e
		summarizeBy: none
		sourceColumn: review_comment_message

		annotation SummarizationSetBy = User

	column review_creation_date
