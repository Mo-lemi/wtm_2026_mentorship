table olist_reviews_master
	lineageTag: 7b9239f1-eb5e-4201-b0b6-4c86f942cb35

	measure 'Avg Review Score' = AVERAGE(olist_reviews_master[review_score])
		formatString: 0.00
		lineageTag: f8187211-defe-4c1d-8f88-edf4e83799ea

	measure 'Review Count' = COUNTROWS(olist_reviews_master)
		formatString: #,0
		lineageTag: 0c6c7846-b223-413a-bba8-9ce6e6915d62

	measure 'Avg Score (Delivered)' = CALCULATE([Avg Review Score], KEEPFILTERS(olist_reviews_master[Delivery Status] <> "Not delivered"))
		formatString: 0.00
		lineageTag: bcf804e0-d98e-4f4b-a334-1b787c302520

	measure 'Late Delivery %' = DIVIDE(CALCULATE([Review Count], olist_reviews_master[Delay Days] > 0), CALCULATE([Review Count], NOT ISBLANK(olist_reviews_master[Delay Days])))
		formatString: 0.0%
		lineageTag: 9d2dd506-0488-4ac5-950a-ae1bdbe54a2b

	column review_id
		dataType: string
		lineageTag: 60118ff9-69d8-4a60-bf4d-b47cbe8f671f
		summarizeBy: none
		sourceColumn: review_id

		annotation SummarizationSetBy = User

	column order_id
		dataType: string
		lineageTag: 18eaa4cb-ef20-40f5-afb5-794eff8fd1fc
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = User

	column review_score
		dataType: int64
		formatString: 0
		lineageTag: 689c0111-db82-4285-885d-3c832d6ae7a9
